+        "complete",
+        "incomplete",
+        "blocked",
+        "invalid",
+        "review_required",
+        "unsupported",
+        "failed",
+        "stale"
+      ]
+    },
+    "run_id": {
+      "type": "string",
+      "pattern": "^[0-9a-f]{16}$"
+    },
+    "request_fingerprint": {
+      "type": "string",
