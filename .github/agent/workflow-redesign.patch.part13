+      "pattern": "^[0-9a-f]{64}$"
+    },
+    "workflow_name": {
+      "type": "string",
+      "minLength": 1
+    },
+    "claim_status": {
+      "type": "string",
+      "minLength": 1
+    },
+    "artifact_base_dir": {
+      "type": "string",
+      "minLength": 1
+    },
+    "result_file": {
+      "type": "string",
+      "minLength": 1
+    },
+    "attempt": {
+      "type": "integer",
+      "minimum": 1
+    },
+    "attempt_history": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["attempt", "status", "blockers"],
+        "properties": {
+          "attempt": {
+            "type": "integer",
+            "minimum": 1
+          },
+          "status": {
+            "type": "string"
+          },
+          "blockers": {
+            "type": "array"
+          }
+        },
+        "additionalProperties": true
+      }
+    },
+    "request": {
+      "type": "object",
+      "required": ["user_request", "config", "source_artifacts"],
+      "properties": {
+        "user_request": {
+          "type": "string",
+          "minLength": 1
+        },
+        "config": {
+          "type": "object"
+        },
+        "source_artifacts": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/artifactReference"
+          }
+        }
+      },
+      "additionalProperties": true
+    },
+    "plan": {
+      "type": "object",
+      "required": ["workflow_name", "tool_chain", "execution_model", "migration_boundary"],
+      "properties": {
+        "workflow_name": {
+          "type": "string"
+        },
+        "tool_chain": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "execution_model": {
+          "type": "string"
+        },
+        "migration_boundary": {
+          "type": "string"
+        }
+      },
+      "additionalProperties": true
+    },
+    "reasoning_model": {
+      "type": "object",
+      "required": ["chain", "rule"],
+      "properties": {
+        "chain": {
+          "const": [
+            "source",
+            "observation",
+            "interpretation",
+            "candidate",
+            "check",
+            "decision",
+            "applied_change",
+            "validation",
+            "claim"
+          ]
+        },
+        "rule": {
+          "type": "string",
+          "minLength": 1
+        }
+      },
+      "additionalProperties": true
+    },
+    "stage_contracts": {
+      "type": "array",
+      "minItems": 5,
+      "items": {
+        "$ref": "#/$defs/stageContract"
+      }
+    },
+    "stage_runs": {
+      "type": "array",
+      "minItems": 5,
+      "items": {
+        "$ref": "#/$defs/stageRun"
+      }
+    },
+    "artifacts": {
+      "type": "array",
+      "items": {
+        "$ref": "#/$defs/artifactIdentity"
+      }
+    },
+    "missing_referenced_artifacts": {
+      "type": "array",
+      "items": {
+        "$ref": "#/$defs/artifactReference"
+      }
+    },
+    "evidence": {
+      "type": "object",
+      "required": [
+        "source_evidence",
+        "parsed_observations",
+        "inferred_facts",
+        "repair_candidates",
+        "accepted_changes",
+        "rejected_changes",
+        "unresolved_uncertainty",
+        "simulation_diagnostics",
+        "product_acceptance_gates"
+      ],
+      "properties": {
+        "source_evidence": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        },
+        "parsed_observations": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        },
+        "inferred_facts": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        },
+        "repair_candidates": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        },
+        "accepted_changes": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        },
+        "rejected_changes": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        },
+        "unresolved_uncertainty": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        },
+        "simulation_diagnostics": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        },
+        "product_acceptance_gates": {
+          "type": "array",
+          "items": {
+            "type": "object"
+          }
+        }
+      },
+      "additionalProperties": false
+    },
+    "blockers": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      }
+    },
+    "review_items": {
+      "type": "array",
+      "items": {
+        "type": "object"
+      }
+    },
+    "next_actions": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      }
+    },
+    "legacy_result_summary": {
+      "type": "object"
+    }
+  },
+  "$defs": {
+    "artifactReference": {
+      "type": "object",
+      "required": ["label", "path"],
+      "properties": {
+        "label": {
+          "type": "string"
+        },
+        "path": {
+          "type": "string"
+        },
+        "state": {
+          "enum": ["present", "missing"]
+        },
+        "role": {
+          "type": "string"
+        },
+        "evidence_kind": {
+          "type": "string"
+        },
+        "producer_stage": {
+          "type": "string"
+        },
+        "sha256": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{64}$"
+        },
+        "bytes": {
+          "type": "integer",
+          "minimum": 0
+        }
+      },
+      "additionalProperties": true
+    },
+    "artifactIdentity": {
+      "allOf": [
+        {
+          "$ref": "#/$defs/artifactReference"
+        },
+        {
+          "required": ["sha256", "bytes", "role", "evidence_kind", "producer_stage"]
+        }
+      ]
+    },
+    "stageContract": {
+      "type": "object",
+      "required": [
+        "stage_id",
+        "version",
+        "inputs",
+        "output_schema",
+        "preconditions",
+        "postconditions",
+        "evidence_consumed",
+        "evidence_produced",
+        "allowed_side_effects",
+        "failure_status",
+        "retry_policy",
+        "cache_policy"
+      ],
+      "properties": {
+        "stage_id": {
+          "type": "string"
+        },
+        "version": {
+          "type": "integer",
+          "minimum": 1
+        },
+        "inputs": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "output_schema": {
+          "type": "string"
+        },
+        "preconditions": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "postconditions": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "evidence_consumed": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "evidence_produced": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "allowed_side_effects": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        },
+        "failure_status": {
+          "type": "string"
+        },
+        "retry_policy": {
+          "type": "string"
+        },
+        "cache_policy": {
+          "type": "string"
+        }
+      },
+      "additionalProperties": true
+    },
+    "stageRun": {
+      "type": "object",
+      "required": ["stage_id", "status"],
+      "properties": {
+        "stage_id": {
+          "type": "string"
+        },
+        "status": {
+          "enum": [
+            "complete",
+            "incomplete",
+            "blocked",
+            "invalid",
+            "review_required",
+            "unsupported",
+            "failed",
+            "stale"
+          ]
+        }
+      },
+      "additionalProperties": true
+    }
+  },
+  "additionalProperties": true
+}
