  "cases": [
    {
      "schema": "torii.corridor.contracts/v1",
      "case_id": "edge-to-edge-connections",
      "normative_feature": "official PlainXML edge-to-edge connection semantics",
      "traffic_side": "right",
      "source_file_ids": [
        "conn-nodes",
        "conn-edges",
        "edge2edge-connections"
      ],
      "netconvert_arguments": [
        "--node-files",
        "@source:conn-nodes",
        "--edge-files",
        "@source:conn-edges",
        "--connection-files",
        "@source:edge2edge-connections",
        "--speed-in-kmh",
        "true",
        "--output-file",
        "@output-net"
      ],
      "expected_internal_link_mode": "internal-links",
      "expected_connection_status": "review_required",
      "expected_connection_category_counts": {
        "ambiguous_target_lane_fanout": 4,
        "incoming_motorized_lane_without_connection": 2,
        "outgoing_motorized_lane_without_connection": 4
      },
      "expected_independent_safety_status": "pass",
      "expected_safety_category_counts": {},
      "expected_movement_count": 28,
      "expected_conflict_count": 20,
      "expected_abstention": true
    },
